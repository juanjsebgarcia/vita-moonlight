S(REC_PRESET_BOOST_OFF, "{0}, {1} fps, {2} Mbps, clock boost off", "{0} = resolution, {1}, {2} = numbers")
S(REC_CONNECTION_GOOD, "Good", "Kind of connection")
S(REC_CONNECTION_WEAK, "Weak", "Kind of connection")
S(REC_APPLIED, "Recommended settings applied.\nConnection: {0}\nWhat matters most: {1}\nSettings: {2}\nFrame pacer and V-Sync are off.", "{0} = Good or Weak, {1} = a priority, {2} = the settings")
S(REC_RESTART_ASK, "These take effect on a new stream. Restart the stream now with the new settings? The game keeps running on your PC.", "")
S(REC_LOOKING_FOR, "Looking for {0}...", "{0} = PC name")
S(REC_CONNECTING, "Connecting to {0}...", "{0} = PC name")
S(REC_CANT_CONNECT, "Auto-detect couldn't connect to {0}: {1}", "{0} = PC name, {1} = the reason")
S(REC_NEEDS_PC, "Auto-detect needs a paired PC that's switched on, to test the connection to it. Turn your PC on, or choose Good or Weak connection yourself.", "")
S(REC_MEASURING, "Measuring the Wi-Fi signal, hold still...\n\nNow {0}%, {1} s left", "{0} = signal strength, {1} = seconds")
S(REC_MEASURING_NO_SIGNAL, "Measuring the Wi-Fi signal, hold still...\n\nNo signal, {0} s left", "{0} = seconds")
S(REC_NO_DESKTOP_APP, "Your PC has no \"{0}\" app in Sunshine, which Auto-detect streams to test the connection.", "{0} = an app name in Sunshine, not translated")
S(REC_TEST_DIDNT_START, "The test stream didn't start.", "")
S(REC_TEST_ENDED, "The test stream ended early.", "")
S(REC_TEST_NO_VIDEO, "No video arrived during the test stream.", "")
S(REC_TEST_NO_DELAY, "The connection's delay couldn't be measured.", "")
S(REC_BUTTON_START, "Start", "Dialog button that starts the test")
S(REC_MOBILE_WARNING, "The Vita is on a mobile (3G) network, which can't carry a smooth stream. Use Wi-Fi if you can. Otherwise choose Weak connection, which needs the least.", "")
S(REC_INTRO_WIRED, "Auto-detect streams {0}'s desktop for about {1} seconds to test the connection. Press {confirm} when you're ready.", "{0} = PC name, {1} = a number; {confirm} is drawn as the button that starts the test")
S(REC_INTRO_WIFI, "Take the Vita to where you'll play, and hold it as you normally would. Then press {confirm}. Auto-detect measures the Wi-Fi signal for {0} seconds, then streams {1}'s desktop for about {2} seconds to test the connection.", "{0}, {2} = numbers, {1} = PC name; {confirm} is drawn as the button that starts the test")
S(REC_NO_SIGNAL_READING, "Couldn't read the Wi-Fi signal. Check the Vita is connected to Wi-Fi.", "")
S(REC_TESTING, "Testing the connection to {0}.\n\nPlease wait while the connection is benchmarked. The PC's desktop shows for about {1} seconds.", "{0} = PC name, {1} = a number")
S(REC_TEST_FAILED, "Auto-detect couldn't finish the connection test: {0}", "{0} = the reason")
S(REC_SIGNAL, "Signal {0}% (lowest {1}%)", "{0}, {1} = numbers")
S(REC_MEASURED, "{0}, {1}% of packets lost, jitter {2} ms.", "{0} = the signal or \"Wired network\", {1}, {2} = numbers")
S(REC_VERDICT_GOOD, "This is a good connection.", "")
S(REC_VERDICT_WEAK, "This is a weak connection.", "")
S(REC_REASON_SIGNAL, "The signal is on the weak side.", "")
S(REC_REASON_LOSS, "Packets went missing during the test.", "")
S(REC_REASON_TIMING, "The connection's timing was uneven.", "")
S(REC_BLUETOOTH, "Bluetooth is on, which can make it worse.", "")
S(REC_RECOMMEND_ASK, "Recommended for {0}: {1}. Apply it?", "{0} = a priority, {1} = the settings")
S(REC_HELP_PRIORITY_PSTV, "Balanced gives the sharpest picture a connection can carry smoothly: 1280x720 at 20 Mbps on a good one. Lowest delay uses 960x540 at 10 Mbps, which cuts the delay by a few milliseconds, more on a weaker connection. Use {left} and {right} to change.", "Help shown with triangle")
S(REC_HELP_PRIORITY, "Balanced gives the sharpest picture a connection can carry smoothly: 1280x720 at 20 Mbps on a good one. Lowest delay uses 960x540 at 10 Mbps, which looks the same on the Vita's screen and cuts the delay by a few milliseconds, more on weaker Wi-Fi. Battery life streams 30 frames a second at 5 Mbps with clock boost off. Use {left} and {right} to change.", "Help shown with triangle")
S(REC_HELP_AUTO, "Tests the connection where you'll play, then recommends settings for it and for what matters most to you. It measures the Wi-Fi signal (unless you're wired), then briefly streams your PC's desktop to check for lost packets and uneven timing. It uses your paired PC if it's on; with several, open Settings from the menu of the one you want. Quit any game on the PC first.", "Help shown with triangle")
S(REC_HELP_GOOD, "For a strong signal, such as in the same room as your router, or a wired PS TV. Applies the settings for what matters most to you; with Balanced that's 1280x720 at 20 Mbps. Also turns the frame pacer and V-Sync off.", "Help shown with triangle")
S(REC_HELP_WEAK, "For a weaker signal, such as further from your router or through walls. Applies the settings for what matters most to you; with Balanced that's 960x540 at 10 Mbps, which looks the same on the Vita's screen and needs half the bandwidth. Also turns the frame pacer and V-Sync off.", "Help shown with triangle")

/* While streaming */
S(STREAM_HINT, "Press {start} + {l} + {r} for the menu and to quit", "Shown at the start of a stream; {start}, {l}, {r} are drawn as the buttons")

/* Settings, About tab: the row names (the values are not translated) */
S(ABOUT_APP, "Moonlight for PS Vita", "About tab row")
S(ABOUT_PROJECT, "Project", "About tab row")
S(ABOUT_MAINTAINERS, "Maintained by", "About tab row")
S(ABOUT_BUILT_ON, "Built on Moonlight", "About tab row")

/* A PC at a new address */
S(HOST_IP_CHANGED_ASK, "Your host changed its IP address.\nOld: {0}\nNew: {1}", "{0}, {1} = IP addresses")
S(HOST_NO_ADDRESS, "(none)", "In place of an IP address")
S(HOST_IP_UPDATED, "Host IP updated!", "")
S(HOST_IP_NOT_UPDATED, "Host IP not updated.", "")

/* Wake on LAN */
S(WAKE_NO_MAC, "No MAC address is saved for {0}, so it can't be woken. Connect to it once while it's on, and Moonlight will remember it.", "{0} = PC name")
S(WAKE_NO_ADDRESS, "No IP address is saved for {0}.", "{0} = PC name")
S(WAKE_BAD_ADDRESS, "{0}'s IP address ({1}) isn't one Wake on LAN can use.", "{0} = PC name, {1} = IP address")
S(WAKE_SEND_FAILED, "Couldn't send the Wake on LAN packet to {0}.", "{0} = PC name")
S(WAKE_TIMED_OUT, "{0} didn't wake up within {1} minutes. Check it's plugged in, connected by cable, and set up for Wake on LAN.", "{0} = PC name, {1} = a number")
S(WAKE_WAITING, "Waking {0}...\n\nWaiting for it to start: {1} s.\nPress {cancel} to stop.", "{0} = PC name, {1} = seconds; {cancel} is drawn as the button")
S(WAKE_STOPPED, "Stopped waiting for {0}.", "{0} = PC name")

/* Starting a stream */
S(STREAM_NO_4K, "Server doesn't support 4K", "")
S(STREAM_MODE_UNSUPPORTED, "Server doesn't support {0} ({1} fps)", "{0} = a resolution such as 1280x720, {1} = a number")
S(STREAM_START_FAILED, "Errorcode starting app: {0}", "{0} = an error number")
S(STREAM_FAILED_STAGE, "Failed to start stream:\nFailed stage: {0}\n(error code {1})", "{0} = a technical stage name in English, {1} = a number")
S(STREAM_APP_RUNNING, "An app is already running on {0}. Quit it from the PC's menu first.", "{0} = PC name")
S(CONNECT_FAILED, "Can't connect to {0}: {1}", "{0} = PC name, {1} = an error from the PC, in English")
S(CONNECT_NO_RESPONSE, "no response", "Used as {1} above")
S(CONNECT_NO_APP_LIST, "Can't read the app list from {0}: {1}", "{0} = PC name, {1} = an error from the PC, in English")

